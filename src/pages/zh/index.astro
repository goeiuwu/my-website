---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Kanso Goods – 木質3D立體拼圖・DIY書立屋 企業批發採購（B2B）',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- 頂部商業公告橫幅 -->
  <div class="bg-[#78350f] text-amber-50 text-xs sm:text-sm py-2.5 px-4 text-center tracking-wide font-medium">
    ✨ 企業與零售通路批發專供 · 1箱起即可混款試單 · 中性無廠牌包裝 · 全球直發配送
  </div>

  <!-- 1. 首屏（Hero） -->
  <section class="relative bg-[#FAF6F0] overflow-hidden border-b border-amber-900/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-14 md:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        <div class="lg:col-span-6 text-left">
          <span class="inline-block text-xs font-bold tracking-widest text-[#92400e] bg-amber-900/10 px-3.5 py-1.5 rounded-full mb-5">
            FLEXIBLE B2B SUPPLY · 精選批發與小量混批
          </span>
          <h1 class="text-3xl sm:text-4xl lg:text-[2.75rem] font-serif font-bold text-stone-900 leading-tight">
            為您的零售貨架精選<span class="text-[#b45309]">木質微縮模型與立體拼圖</span>
          </h1>
          <p class="mt-5 text-base text-stone-600 leading-relaxed">
            嚴選感應式 LED DIY 書立屋、微縮娃娃屋與木質 3D 機械拼圖，直接供應全球書店、文創禮品店與經銷商。支援<strong>單箱低門檻混批試單</strong>與<strong>無工廠 Logo 中性包裝</strong>，助您靈活建立自有通路利潤。
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href="#inquiry"
              class="px-7 py-3.5 rounded-full bg-[#8B4513] hover:bg-[#6F360E] text-white font-semibold shadow-md transition-colors"
            >
              獲取目錄與報價
            </a>
            <a
              href="#products"
              class="px-7 py-3.5 rounded-full bg-white hover:bg-stone-50 text-stone-800 font-semibold border border-stone-300 transition-colors"
            >
              瀏覽產品系列
            </a>
          </div>

          <div class="mt-10 pt-6 border-t border-amber-900/10 grid grid-cols-3 gap-4 text-left">
            <div>
              <p class="font-bold text-stone-900 text-sm sm:text-base">1 箱起批</p>
              <p class="text-xs text-stone-500 mt-0.5">現貨支援多款混裝試銷</p>
            </div>
            <div>
              <p class="font-bold text-stone-900 text-sm sm:text-base">中性包裝</p>
              <p class="text-xs text-stone-500 mt-0.5">無工廠標識・便於貼標上架</p>
            </div>
            <div>
              <p class="font-bold text-stone-900 text-sm sm:text-base">3–7 天發貨</p>
              <p class="text-xs text-stone-500 mt-0.5">支援海空運門到門配送</p>
            </div>
          </div>
        </div>

        <div class="lg:col-span-6">
          <div class="rounded-3xl overflow-hidden shadow-2xl border border-amber-900/10 bg-white p-3">
            <img
              src="/product/product-1.jpg"
              alt="DIY Book Nook Miniature Kit"
              class="w-full h-auto object-cover aspect-square rounded-2xl"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. 產品系列（帶實拍大圖卡片） -->
  <section id="products" class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <p class="text-xs font-bold tracking-widest uppercase text-[#92400e]">FEATURED WHOLESALE CATALOG</p>
        <h2 class="text-3xl md:text-4xl font-serif font-bold text-stone-900 mt-2">
          熱銷書立屋與木質立體拼圖系列
        </h2>
        <p class="mt-3 text-stone-600 text-sm sm:text-base">
          精密雷射切割環保椴木套件，內建觸控感應式暖光 LED 燈組。支援單箱自由混搭多款型號進行試銷。
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- 卡片 1 -->
        <div class="group rounded-3xl border border-stone-200/80 overflow-hidden bg-white shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col">
          <div class="aspect-square overflow-hidden bg-[#FAF6F0]">
            <img
              src="/product/product-2.webp"
              alt="Classic Bookshelf Alley Kit"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <span class="inline-block text-[11px] font-bold tracking-wider uppercase text-[#92400e] bg-amber-900/10 px-2.5 py-1 rounded-md">
                LED BOOK NOOK
              </span>
              <h3 class="text-xl font-bold text-stone-900 mt-3">經典烘焙坊與書巷微縮套件</h3>
              <p class="mt-2 text-sm text-stone-600 leading-relaxed">
                觸控感應 LED 暖光・精密木質零件・無工廠 Logo 中性彩盒包裝。
              </p>
            </div>
            <div class="mt-5 pt-4 border-t border-stone-100 flex items-center justify-between text-xs font-semibold">
              <span class="text-stone-500">MOQ: 1 箱起批</span>
              <a href="#inquiry" class="text-[#8B4513] hover:underline">獲取價格表 →</a>
            </div>
          </div>
        </div>

        <!-- 卡片 2 -->
        <div class="group rounded-3xl border border-stone-200/80 overflow-hidden bg-white shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col">
          <div class="aspect-square overflow-hidden bg-[#FAF6F0]">
            <img
              src="/product/product-3.webp"
              alt="Vintage Street & Cafe Scene"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <span class="inline-block text-[11px] font-bold tracking-wider uppercase text-[#92400e] bg-amber-900/10 px-2.5 py-1 rounded-md">
                LED BOOK NOOK
              </span>
              <h3 class="text-xl font-bold text-stone-900 mt-3">復古街角便利店與咖啡館場景</h3>
              <p class="mt-2 text-sm text-stone-600 leading-relaxed">
                全彩步驟圖解說明書，極具陳列吸睛度，適合書店與禮品專櫃主推。
              </p>
            </div>
            <div class="mt-5 pt-4 border-t border-stone-100 flex items-center justify-between text-xs font-semibold">
              <span class="text-stone-500">MOQ: 1 箱起批</span>
              <a href="#inquiry" class="text-[#8B4513] hover:underline">獲取價格表 →</a>
            </div>
          </div>
        </div>

        <!-- 卡片 3 -->
        <div class="group rounded-3xl border border-stone-200/80 overflow-hidden bg-white shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col">
          <div class="aspect-square overflow-hidden bg-[#FAF6F0]">
            <img
              src="/product/product-4.jpg"
              alt="Mechanical Architecture Model"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <span class="inline-block text-[11px] font-bold tracking-wider uppercase text-[#92400e] bg-amber-900/10 px-2.5 py-1 rounded-md">
                3D WOODEN PUZZLE
              </span>
              <h3 class="text-xl font-bold text-stone-900 mt-3">木質 3D 機械書屋建築模型</h3>
              <p class="mt-2 text-sm text-stone-600 leading-relaxed">
                物理榫卯卡扣設計・天然環保椴木材質，組裝手感流暢，兼具擺飾與收藏價值。
              </p>
            </div>
            <div class="mt-5 pt-4 border-t border-stone-100 flex items-center justify-between text-xs font-semibold">
              <span class="text-stone-500">MOQ: 1 箱起批</span>
              <a href="#inquiry" class="text-[#8B4513] hover:underline">獲取價格表 →</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. 合作優勢 -->
  <section id="features" class="py-16 bg-[#FAF6F0] border-y border-amber-900/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <p class="text-xs font-bold tracking-widest uppercase text-[#92400e]">WHY PARTNER WITH US</p>
        <h2 class="text-3xl font-serif font-bold text-stone-900 mt-2">
          為什麼選擇 Kanso Goods 作為您的供應商
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white p-6 rounded-2xl border border-amber-900/10">
          <div class="text-2xl mb-3">📦</div>
          <h3 class="font-bold text-stone-900">1 箱低門檻混款試單</h3>
          <p class="mt-2 text-sm text-stone-600 leading-relaxed">
            所有現貨款式均支援單箱起訂，且允許在 1 箱內自由混搭不同熱銷型號，讓您以最低庫存成本測試終端銷售表現。
          </p>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-amber-900/10">
          <div class="text-2xl mb-3">🏷️</div>
          <h3 class="font-bold text-stone-900">中性包裝・保護通路定價</h3>
          <p class="mt-2 text-sm text-stone-600 leading-relaxed">
            外盒潔淨無任何製造工廠標識，防止終端比價，並方便您直接黏貼自有門市條碼或品牌貼紙上架。
          </p>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-amber-900/10">
          <div class="text-2xl mb-3">🔍</div>
          <h3 class="font-bold text-stone-900">出貨前嚴格全檢與補件保障</h3>
          <p class="mt-2 text-sm text-stone-600 leading-relaxed">
            每批貨物均經過配件稱重核對、LED 燈組通電測試及機芯檢測。若運輸途中發生破損或缺件，提供補件。
          </p>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-amber-900/10">
          <div class="text-2xl mb-3">🌏</div>
          <h3 class="font-bold text-stone-900">國際安全認證與彈性物流</h3>
          <p class="mt-2 text-sm text-stone-600 leading-relaxed">
            採用環保椴木與無毒材質，符合 EN71、CE 及 ASTM 等國際安全標準。支援 DDP 門到門空海運或指定貨代交貨。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. 在線詢盤表單 -->
  <section id="inquiry" class="py-16 md:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="bg-[#FAF6F0] rounded-3xl shadow-xl border border-amber-900/10 p-8 md:p-12">
        <div class="text-center max-w-2xl mx-auto mb-8">
          <p class="text-xs font-bold tracking-widest uppercase text-[#92400e]">WHOLESALE CATALOG &amp; PRICE LIST</p>
          <h2 class="text-2xl md:text-4xl font-serif font-bold text-stone-900 mt-2">
            獲取完整目錄與價格表
          </h2>
          <p class="mt-3 text-sm sm:text-base text-stone-600">
            請填寫以下資訊，我們將在 24小時內將超過 100 款電子型錄、裝箱規格明細及分級報價表發送至您的信箱。
          </p>
        </div>

        <form action="https://api.web3forms.com/submit" method="POST" class="space-y-5">
          <input type="hidden" name="access_key" value="8dfb5b66-c7b7-4c72-83db-b36d3817da76" />
          <input type="hidden" name="subject" value="New Chinese B2B Wholesale Inquiry - Kanso Goods" />
          <input type="hidden" name="from_name" value="Kanso Goods Chinese Page" />
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-sm font-medium text-stone-700 mb-1.5">聯絡人姓名 *</label>
              <input type="text" name="name" required placeholder="例如：陳小姐 / 林先生" class="w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-stone-900 focus:border-[#92400e] focus:outline-none" />
            </div>
            <div>
              <label class="block text-sm font-medium text-stone-700 mb-1.5">企業電子信箱 *</label>
              <input type="email" name="email" required placeholder="buyer@yourstore.com" class="w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-stone-900 focus:border-[#92400e] focus:outline-none" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-sm font-medium text-stone-700 mb-1.5">公司 / 店舖名稱 *</label>
              <input type="text" name="company" required placeholder="例如：誠品生活選品 / 某某文創店" class="w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-stone-900 focus:border-[#92400e] focus:outline-none" />
            </div>
            <div>
              <label class="block text-sm font-medium text-stone-700 mb-1.5">所在國家 / 地區 *</label>
              <input type="text" name="country" required placeholder="例如：台灣 / 香港 / 新加坡 / 馬來西亞" class="w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-stone-900 focus:border-[#92400e] focus:outline-none" />
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-stone-700 mb-1.5">採購需求說明（選填）</label>
            <textarea name="message" rows="3" placeholder="請告訴我們您感興趣的系列、預計採購箱數或條碼貼標需求..." class="w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-stone-900 focus:border-[#92400e] focus:outline-none"></textarea>
          </div>

          <div class="pt-2 flex flex-col sm:flex-row items-center justify-between gap-4">
            <button type="submit" class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-[#8B4513] hover:bg-[#6F360E] text-white font-semibold shadow-md transition-colors cursor-pointer">
              立即獲取目錄與報價
            </button>
            <p class="text-sm text-stone-500">
              或直接來信：<a href="mailto:info@kansogoods.com" class="font-medium text-[#8B4513] underline">info@kansogoods.com</a>
            </p>
          </div>
        </form>
      </div>
    </div>
  </section>
</Layout>
