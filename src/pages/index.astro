---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Kanso Goods — Wholesale Wooden 3D Puzzles & DIY Book Nooks Supplier',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- 1. 首屏主视觉 -->
  <Hero
    tagline="Global B2B Wholesale & Sourcing"
    actions={[
      {
        variant: 'primary',
        text: 'Get Wholesale Price List',
        href: '/contact',
        icon: 'tabler:mail',
      },
      { text: 'Explore Products', href: '#products' },
    ]}
    image={{ src: '/1.1/hero.png', alt: 'Wholesale Wooden 3D Puzzles & DIY Book Nooks' }}
  >
    <Fragment slot="title">
      Wholesale <span class="text-accent dark:text-white">Wooden 3D Puzzles</span> & DIY Book Nooks
    </Fragment>

    <Fragment slot="subtitle">
      <span class="font-semibold">Kanso Goods</span> supplies retail-ready wooden mechanical models and miniature book nooks with factory-direct FOB Shenzhen pricing, 1-carton low MOQ trial orders, and neutral packaging.
    </Fragment>
  </Hero>

  <!-- 2. 核心采购优势 -->
  <Features
    id="features"
    tagline="Why Partner With Us"
    title="Built for Overseas Retailers & Distributors"
    subtitle="Flexible supply chain solutions designed to lower your inventory risk and protect your retail margins."
    items={[
      {
        title: '1-Carton Low MOQ Trial Orders',
        description:
          'Test market demand with as little as 1 carton. Mixed models are supported so you can evaluate multiple SKUs in one shipment.',
        icon: 'tabler:box',
      },
      {
        title: 'Neutral & Unbranded Packaging',
        description:
          'All products come in clean, neutral packaging without factory logos—ready for your own retail distribution or private label stickers.',
        icon: 'tabler:package',
      },
      {
        title: 'Factory-Direct FOB Shenzhen Pricing',
        description:
          'Transparent tiered USD pricing sourced directly from vetted Dongguan & Shenzhen manufacturers with full export documentation.',
        icon: 'tabler:currency-dollar',
      },
      {
        title: 'Strict QC & Global Logistics',
        description:
          'Precision laser-cut basswood boards inspected before dispatch. Flexible shipping via air express, sea freight, or DDP door-to-door.',
        icon: 'tabler:world',
      },
    ]}
  />

  <!-- 3. 产品系列展示 -->
  <Content
    id="products"
    isReversed
    tagline="Product Catalog"
    title="DIY Book Nooks & Miniature Houses"
    items={[
      {
        title: 'Intricate LED-Lit Scenes',
        description:
          'Includes touch-switch warm LED lighting, precision laser-cut wooden parts, and step-by-step English illustrated manuals.',
      },
      {
        title: 'High Retail Appeal',
        description:
          'Proven bestsellers for bookstores, gift shops, hobby retailers, and online marketplaces across North America, Europe, and Asia.',
      },
    ]}
    image={{
      src: '/1.1/hero.png',
      alt: 'DIY Book Nook Kits Wholesale',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Trending DIY Book Nook Kits
      </h3>
      Designed to fit neatly between books on any shelf, turning ordinary bookshelves into charming miniature worlds.
    </Fragment>
  </Content>

  <!-- 4. 采购合作流程 -->
  <Steps
    id="process"
    title="Simple 3-Step Wholesale Process"
    items={[
      {
        title: 'Step 1: <span class="font-medium">Request Catalog & FOB Price List</span>',
        description:
          'Contact us with your target market and estimated order volume to receive our full digital catalog and tiered FOB Shenzhen price sheet.',
        icon: 'tabler:file-spreadsheet',
      },
      {
        title: 'Step 2: <span class="font-medium">Place a 1-Carton Trial Order</span>',
        description:
          'Select your preferred models starting from just 1 carton. Samples and mixed-SKU trial orders are dispatched quickly from stock.',
        icon: 'tabler:shopping-cart',
      },
      {
        title: 'Step 3: <span class="font-medium">Quality Inspection & Dispatch</span>',
        description:
          'We verify carton counts, packaging condition, and shipping marks before arranging smooth global delivery to your port or warehouse.',
        icon: 'tabler:truck-delivery',
      },
    ]}
  />

  <!-- 5. 买家常见问题 FAQ -->
  <FAQs
    id="faq"
    title="Frequently Asked Questions"
    tagline="Wholesale FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'What is your Minimum Order Quantity (MOQ)?',
        description:
          'We support 1-carton trial orders for ready-to-ship models, allowing you to mix different designs to test local customer response.',
      },
      {
        title: 'Do the boxes show any factory brand names?',
        description:
          'No. We provide neutral packaging free of third-party factory branding so your retail channels remain fully protected.',
      },
      {
        title: 'What price terms and payment methods do you offer?',
        description:
          'We quote primarily in FOB Shenzhen (USD), and can also assist with EXW, CIF, or DDP door-to-door quotes. Standard payment is T/T bank transfer.',
      },
      {
        title: 'How long is the lead time for orders?',
        description:
          'In-stock trial orders ship within 3–7 business days after payment confirmation. Larger volume orders typically take 15–25 days.',
      },
    ]}
  />

  <!-- 底部询盘号召 -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Request Wholesale Price List',
        href: '/contact',
        icon: 'tabler:mail',
      },
    ]}
  >
    <Fragment slot="title">
      Ready to Source Wooden 3D Puzzles?
    </Fragment>

    <Fragment slot="subtitle">
      Email us at <span class="font-semibold">info@kansogoods.com</span> or send an inquiry to receive our latest catalog and carton specs.
    </Fragment>
  </CallToAction>
</Layout>
