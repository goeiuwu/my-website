---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Kanso Goods — Wholesale Wooden 3D Puzzles & DIY Book Nooks',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- 1. 沉浸式首屏大图 (Hero) -->
  <Hero
    tagline="Factory-Direct B2B Wholesale · FOB Shenzhen"
    actions={[
      {
        variant: 'primary',
        text: 'Get Wholesale Price List',
        href: '/contact',
        icon: 'tabler:file-dollar',
      },
      { text: 'View Collection', href: '#collection' },
    ]}
    image={{ src: '/1.1/hero.png', alt: 'DIY Book Nook & Wooden 3D Puzzle Collection' }}
  >
    <Fragment slot="title">
      Bring Miniature Worlds to <span class="text-accent dark:text-white">Your Retail Shelves</span>
    </Fragment>

    <Fragment slot="subtitle">
      Curated DIY Book Nooks, Miniature Dollhouses & Wooden 3D Mechanical Puzzles. Supported by <span class="font-semibold">1-carton low MOQ</span>, neutral packaging, and fast global dispatch.
    </Fragment>
  </Hero>

  <!-- 2. 仿 CuteBee 爆款产品画廊展示区 (Featured Collection) -->
  <section id="collection" class="py-16 md:py-20 bg-amber-50/40 dark:bg-slate-900/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <p class="text-base text-primary font-bold tracking-wide uppercase">Featured Wholesale Catalog</p>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight mt-2">
          Bestselling DIY Book Nooks & Wooden Puzzles
        </h2>
        <p class="mt-4 text-lg text-muted">
          Precision laser-cut basswood kits with touch-switch LED lighting. Ready for 1-carton mixed trial orders.
        </p>
      </div>

      <!-- 3列高清产品卡片网格 -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- 产品卡片 1 -->
        <div class="group bg-white dark:bg-slate-800 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-amber-900/10">
          <div class="aspect-square overflow-hidden bg-amber-50">
            <img src="/1.1/hero.png" alt="Classic Library Book Nook" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="p-6">
            <span class="text-xs font-semibold uppercase tracking-wider text-amber-800 bg-amber-100 px-2.5 py-1 rounded-full">LED Book Nook</span>
            <h3 class="text-xl font-bold mt-3">Classic Bookshelf Alley Kit</h3>
            <p class="text-sm text-muted mt-2">Warm touch-sensor LED · 220+ laser-cut pieces · Neutral retail box</p>
            <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-700 flex justify-between items-center text-sm">
              <span class="font-medium text-gray-600 dark:text-gray-300">MOQ: 1 Carton</span>
              <a href="/contact" class="text-primary font-semibold hover:underline">Inquire FOB Price →</a>
            </div>
          </div>
        </div>

        <!-- 产品卡片 2 -->
        <div class="group bg-white dark:bg-slate-800 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-amber-900/10">
          <div class="aspect-square overflow-hidden bg-amber-50">
            <img src="/1.1/p1.png" alt="Miniature Cafe Book Nook" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="p-6">
            <span class="text-xs font-semibold uppercase tracking-wider text-amber-800 bg-amber-100 px-2.5 py-1 rounded-full">LED Book Nook</span>
            <h3 class="text-xl font-bold mt-3">Vintage Street & Cafe Scene</h3>
            <p class="text-sm text-muted mt-2">Dust cover included · English illustrated manual · High gift appeal</p>
            <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-700 flex justify-between items-center text-sm">
              <span class="font-medium text-gray-600 dark:text-gray-300">MOQ: 1 Carton</span>
              <a href="/contact" class="text-primary font-semibold hover:underline">Inquire FOB Price →</a>
            </div>
          </div>
        </div>

        <!-- 产品卡片 3 -->
        <div class="group bg-white dark:bg-slate-800 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-amber-900/10">
          <div class="aspect-square overflow-hidden bg-amber-50">
            <img src="/1.1/p2.png" alt="Wooden 3D Mechanical Puzzle" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="p-6">
            <span class="text-xs font-semibold uppercase tracking-wider text-amber-800 bg-amber-100 px-2.5 py-1 rounded-full">3D Wooden Puzzle</span>
            <h3 class="text-xl font-bold mt-3">Mechanical Architecture Model</h3>
            <p class="text-sm text-muted mt-2">Glue-free mortise & tenon assembly · Eco-friendly natural basswood</p>
            <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-700 flex justify-between items-center text-sm">
              <span class="font-medium text-gray-600 dark:text-gray-300">MOQ: 1 Carton</span>
              <a href="/contact" class="text-primary font-semibold hover:underline">Inquire FOB Price →</a>
            </div>
          </div>
        </div>

        <!-- 产品卡片 4 -->
        <div class="group bg-white dark:bg-slate-800 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-amber-900/10">
          <div class="aspect-square overflow-hidden bg-amber-50">
            <img src="/1.1/p3.png" alt="Fantasy Magic Study Book Nook" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="p-6">
            <span class="text-xs font-semibold uppercase tracking-wider text-amber-800 bg-amber-100 px-2.5 py-1 rounded-full">Bestseller</span>
            <h3 class="text-xl font-bold mt-3">Magic Study Miniature Nook</h3>
            <p class="text-sm text-muted mt-2">Top-selling bookstore & hobby shop SKU · Rich miniature furniture details</p>
            <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-700 flex justify-between items-center text-sm">
              <span class="font-medium text-gray-600 dark:text-gray-300">MOQ: 1 Carton</span>
              <a href="/contact" class="text-primary font-semibold hover:underline">Inquire FOB Price →</a>
            </div>
          </div>
        </div>

        <!-- 产品卡片 5 -->
        <div class="group bg-white dark:bg-slate-800 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-amber-900/10">
          <div class="aspect-square overflow-hidden bg-amber-50">
            <img src="/1.1/p4.png" alt="DIY Miniature Greenhouse" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="p-6">
            <span class="text-xs font-semibold uppercase tracking-wider text-amber-800 bg-amber-100 px-2.5 py-1 rounded-full">Miniature House</span>
            <h3 class="text-xl font-bold mt-3">Botanical Garden Miniature Kit</h3>
            <p class="text-sm text-muted mt-2">Intricate plant & glasshouse accessories · Ideal for holiday gifting</p>
            <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-700 flex justify-between items-center text-sm">
              <span class="font-medium text-gray-600 dark:text-gray-300">MOQ: 1 Carton</span>
              <a href="/contact" class="text-primary font-semibold hover:underline">Inquire FOB Price →</a>
            </div>
          </div>
        </div>

        <!-- 产品卡片 6 -->
        <div class="group bg-white dark:bg-slate-800 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-amber-900/10">
          <div class="aspect-square overflow-hidden bg-amber-50">
            <img src="/1.1/p5.png" alt="Wooden Music Box 3D Puzzle" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="p-6">
            <span class="text-xs font-semibold uppercase tracking-wider text-amber-800 bg-amber-100 px-2.5 py-1 rounded-full">Mechanical Music Box</span>
            <h3 class="text-xl font-bold mt-3">Rotating Wooden Music Box</h3>
            <p class="text-sm text-muted mt-2">Smooth mechanical movement · Pre-tested wind-up melody core</p>
            <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-700 flex justify-between items-center text-sm">
              <span class="font-medium text-gray-600 dark:text-gray-300">MOQ: 1 Carton</span>
              <a href="/contact" class="text-primary font-semibold hover:underline">Inquire FOB Price →</a>
            </div>
          </div>
        </div>
      </div>

      <!-- 画廊底部索取完整目录按钮 -->
      <div class="text-center mt-12">
        <a
          href="/contact"
          class="inline-flex items-center justify-center px-8 py-3.5 text-base font-semibold text-white bg-primary hover:bg-secondary rounded-full shadow-md transition-colors"
        >
          Request Full 100+ SKU Digital Catalog & FOB Price Sheet
        </a>
      </div>
    </div>
  </section>

  <!-- 3. 核心 B2B 合作优势 -->
  <Features
    id="features"
    tagline="Why Partner With Kanso Goods"
    title="Designed for Retailers, Bookstores & Distributors"
    subtitle="We combine boutique product aesthetics with flexible wholesale terms to maximize your retail margins."
    items={[
      {
        title: '1-Carton Low MOQ Trial Orders',
        description:
          'Test customer response with just 1 carton. Mix and match bestselling Book Nooks and 3D Puzzles in a single order.',
        icon: 'tabler:box',
      },
      {
        title: 'Neutral & Unbranded Packaging',
        description:
          'Clean packaging with zero third-party factory logos—protecting your channel pricing and ready for private-label stickers.',
        icon: 'tabler:package',
      },
      {
        title: 'Factory-Direct FOB Shenzhen',
        description:
          'Competitive tiered USD pricing directly from vetted Dongguan & Shenzhen manufacturing lines.',
        icon: 'tabler:currency-dollar',
      },
      {
        title: '100% QC & Global Door-to-Door',
        description:
          'Strict pre-shipment inspection with flexible air express, sea freight, and DDP delivery worldwide.',
        icon: 'tabler:world',
      },
    ]}
  />

  <!-- 4. 采购三步走 -->
  <Steps
    id="process"
    title="Simple 3-Step Wholesale Process"
    items={[
      {
        title: 'Step 1: <span class="font-medium">Request Digital Catalog & Price List</span>',
        description:
          'Email us your store type and target region to receive our full catalog with carton dimensions, gross weight, and FOB Shenzhen prices.',
        icon: 'tabler:file-spreadsheet',
      },
      {
        title: 'Step 2: <span class="font-medium">Confirm 1-Carton Trial Selection</span>',
        description:
          'Choose your trial SKUs starting from 1 carton. Ready-to-ship inventory dispatches within 3–7 business days.',
        icon: 'tabler:shopping-cart',
      },
      {
        title: 'Step 3: <span class="font-medium">Inspection & Global Delivery</span>',
        description:
          'We send pre-shipment inspection photos and shipping documents before dispatching directly to your warehouse or port.',
        icon: 'tabler:truck-delivery',
      },
    ]}
  />

  <!-- 5. 常见问题 FAQ -->
  <FAQs
    id="faq"
    title="Wholesale Frequently Asked Questions"
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'Can I mix different designs in my first trial order?',
        description:
          'Yes. For in-stock models, we welcome 1-carton trial orders and mixed-SKU assortments so you can evaluate bestsellers in your market.',
      },
      {
        title: 'Do the product boxes display any factory brand names?',
        description:
          'No. All our wholesale shipments use clean, neutral packaging without factory branding.',
      },
      {
        title: 'What are your payment and shipping terms?',
        description:
          'We quote primarily in FOB Shenzhen (USD) and also support EXW, CIF, and DDP door-to-door shipping. Payment is via T/T bank transfer.',
      },
      {
        title: 'How quickly can I receive a quote?',
        description:
          'Send an inquiry to info@kansogoods.com and we will reply with the catalog and tiered price list within 24 hours.',
      },
    ]}
  />

  <!-- 6. 底部询盘转化号召 -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Email info@kansogoods.com',
        href: '/contact',
        icon: 'tabler:mail',
      },
    ]}
  >
    <Fragment slot="title">
      Ready to Stock Bestselling Wooden Kits?
    </Fragment>

    <Fragment slot="subtitle">
      Contact <span class="font-semibold">info@kansogoods.com</span> today for our latest wholesale catalog and FOB Shenzhen pricing.
    </Fragment>
  </CallToAction>
</Layout>
