---
import Layout from '~/layouts/PageLayout.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Kanso Goods — Wholesale Wooden 3D Puzzles & DIY Book Nooks',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- 顶部商业公告横幅 -->
  <div class="bg-[#78350f] text-amber-50 text-xs sm:text-sm py-2.5 px-4 text-center tracking-wide font-medium">
    ✨ Wholesale B2B Supply · 1-Carton Trial Orders Available · Neutral Packaging · Global Shipping
  </div>

  <!-- 1. 暖米色杂志画廊风首屏 (左文右大图) -->
  <section class="relative bg-[#FAF6F0] dark:bg-slate-900 overflow-hidden border-b border-amber-900/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-14 md:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        <!-- 左侧文案区 -->
        <div class="lg:col-span-6 text-left">
          <span class="inline-block text-xs font-bold uppercase tracking-widest text-[#92400e] bg-amber-900/10 px-3.5 py-1.5 rounded-full mb-5">
            Factory-Direct B2B Wholesale
          </span>
          <h1 class="text-4xl sm:text-5xl lg:text-[3.25rem] font-serif font-bold text-stone-900 dark:text-white leading-[1.15] tracking-tight">
            Crafted Miniature Worlds for <span class="text-[#b45309] italic">Your Retail Shelves</span>
          </h1>
          <p class="mt-6 text-lg text-stone-600 dark:text-stone-300 leading-relaxed max-w-xl">
            Curated LED DIY Book Nooks, Miniature Dollhouses & Wooden 3D Mechanical Puzzles. Supported by <strong class="text-stone-800 dark:text-white">1-carton low MOQ</strong>, clean neutral boxes, and fast global dispatch.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a
              href="/contact"
              class="inline-flex items-center justify-center px-7 py-3.5 text-base font-semibold text-white bg-[#92400e] hover:bg-[#78350f] rounded-full shadow-md hover:shadow-lg transition-all"
            >
              Get Wholesale Price List
            </a>
            <a
              href="#collection"
              class="inline-flex items-center justify-center px-7 py-3.5 text-base font-semibold text-[#78350f] bg-white hover:bg-amber-50 border border-amber-900/20 rounded-full transition-all"
            >
              Explore Collection
            </a>
          </div>
          <!-- 信任数据小标签 -->
          <div class="mt-10 pt-6 border-t border-amber-900/10 grid grid-cols-3 gap-4 text-sm">
            <div>
              <p class="font-bold text-stone-900 dark:text-white text-base">1 Carton</p>
              <p class="text-stone-500 text-xs mt-0.5">Low Trial MOQ</p>
            </div>
            <div>
              <p class="font-bold text-stone-900 dark:text-white text-base">Neutral Box</p>
              <p class="text-stone-500 text-xs mt-0.5">Zero Factory Logos</p>
            </div>
            <div>
              <p class="font-bold text-stone-900 dark:text-white text-base">3–7 Days</p>
              <p class="text-stone-500 text-xs mt-0.5">In-Stock Dispatch</p>
            </div>
          </div>
        </div>

        <!-- 右侧沉浸式大图画框 -->
        <div class="lg:col-span-6">
          <div class="relative rounded-3xl overflow-hidden shadow-2xl border-4 border-white dark:border-slate-800 bg-amber-100">
            <img
              src="/product/product-1.jpg"
              alt="DIY Book Nook & Wooden 3D Puzzle Collection"
              class="w-full h-auto object-cover aspect-square"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. 精品产品画廊展示区 -->
  <section id="collection" class="py-16 md:py-24 bg-white dark:bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <p class="text-xs font-bold tracking-widest uppercase text-[#92400e]">Featured Wholesale Catalog</p>
        <h2 class="text-3xl md:text-4xl font-serif font-bold text-stone-900 dark:text-white mt-2">
          Bestselling Book Nooks & Wooden Puzzles
        </h2>
        <p class="mt-3 text-base text-stone-600 dark:text-stone-400">
          Precision laser-cut basswood kits with warm touch-sensor LED lighting. Mix designs in a single trial carton.
        </p>
      </div>

      <!-- 3列画廊卡片（当前暂用 hero.png 占位防裂图，传好 p1~p5 后替换文件名即可） -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {[
          { tag: 'LED Book Nook', title: 'Classic Bookshelf Alley Kit', desc: 'Warm touch-sensor LED · 220+ laser-cut pieces · Neutral box', img: '/product/product-2.webp' },
          { tag: 'LED Book Nook', title: 'Vintage Street & Cafe Scene', desc: 'Dust cover included · English illustrated manual', img: '/product/product-3.webp' },
          { tag: '3D Wooden Puzzle', title: 'Mechanical Architecture Model', desc: 'Glue-free mortise & tenon assembly · Natural basswood', img: '/product/product-4.jpg'},
          { tag: 'Bestseller', title: 'Magic Study Miniature Nook', desc: 'Top bookstore & gift shop SKU · Rich miniature details', img: '/product/product-5.jpg'},
          { tag: 'Miniature House', title: 'Botanical Garden Greenhouse', desc: 'Intricate glasshouse accessories · High holiday gift appeal', img: '/product/product-6.webp' },
          { tag: 'Music Box Kit', title: 'Rotating Wooden Music Box', desc: 'Smooth mechanical movement · Pre-tested wind-up core', img: '/product/product-7.webp' },
        ].map((item) => (
          <div class="group bg-[#FAF6F0]/60 dark:bg-slate-900 rounded-2xl overflow-hidden border border-amber-900/10 hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
            <div class="aspect-square overflow-hidden bg-amber-100/50">
              <img
                src={item.img}
                alt={item.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="p-6">
              <span class="text-xs font-semibold uppercase tracking-wider text-[#92400e] bg-amber-900/10 px-2.5 py-1 rounded-full">
                {item.tag}
              </span>
              <h3 class="text-xl font-serif font-bold text-stone-900 dark:text-white mt-3">{item.title}</h3>
              <p class="text-sm text-stone-600 dark:text-stone-400 mt-2">{item.desc}</p>
              <div class="mt-5 pt-4 border-t border-amber-900/10 flex justify-between items-center text-sm">
                <span class="font-medium text-stone-600 dark:text-stone-300">MOQ: 1 Carton</span>
                <a href="/contact" class="text-[#92400e] font-bold hover:underline">Request Price List →</a>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="text-center mt-14">
        <a
          href="/contact"
          class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold text-white bg-[#92400e] hover:bg-[#78350f] rounded-full shadow-md transition-all"
        >
          Request Full 100+ SKU Digital Catalog & Price List
        </a>
      </div>
    </div>
  </section>

  <!-- 3. 核心 B2B 合作优势 -->
  <Features
    id="features"
    tagline="Why Partner With Kanso Goods"
    title="Designed for Retailers, Bookstores & Distributors"
    subtitle="Boutique product aesthetics paired with flexible wholesale terms to maximize your retail margins."
    items={[
      {
        title: '1-Carton Low MOQ Trial Orders',
        description: 'Test customer response with just 1 carton. Mix bestselling Book Nooks and 3D Puzzles in one order.',
        icon: 'tabler:box',
      },
      {
        title: 'Neutral & Unbranded Packaging',
        description: 'Clean packaging with zero factory logos—protecting your channel pricing and ready for private-label stickers.',
        icon: 'tabler:package',
      },
      {
        title: 'Factory-Direct Global Shipping',
        description: 'Competitive tiered USD pricing directly from vetted Dongguan & Shenzhen manufacturing lines.',
        icon: 'tabler:currency-dollar',
      },
      {
        title: '100% QC & Global Door-to-Door',
        description: 'Strict pre-shipment inspection with air express, sea freight, and DDP delivery worldwide.',
        icon: 'tabler:world',
      },
    ]}
  />

  <!-- 4. 采购三步走 -->
  <Steps
    id="process"
    title="Simple 3-Step Wholesale Process"
    items={[
      {
        title: 'Step 1: <span class="font-medium">Request Digital Catalog & Price List</span>',
        description: 'Email us your store type and target region for carton specs, gross weight, and Global Shipping prices.',
        icon: 'tabler:file-spreadsheet',
      },
      {
        title: 'Step 2: <span class="font-medium">Confirm 1-Carton Trial Selection</span>',
        description: 'Choose your trial SKUs starting from 1 carton. In-stock inventory dispatches within 3–7 business days.',
        icon: 'tabler:shopping-cart',
      },
      {
        title: 'Step 3: <span class="font-medium">Inspection & Global Delivery</span>',
        description: 'Receive pre-shipment inspection photos and shipping documents before dispatch to your warehouse.',
        icon: 'tabler:truck-delivery',
      },
    ]}
  />

  <!-- 5. 常见问题 FAQ -->
  <FAQs
    id="faq"
    title="Wholesale Frequently Asked Questions"
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'Can I mix different designs in my first trial order?',
        description: 'Yes. For in-stock models, we welcome 1-carton trial orders and mixed-SKU assortments.',
      },
      {
        title: 'Do the product boxes display any factory brand names?',
        description: 'No. All wholesale shipments use clean, neutral packaging without factory branding.',
      },
      {
        title: 'What are your payment and shipping terms?',
        description: 'We quote primarily in Global Shipping (USD) and support EXW, CIF, and DDP shipping via T/T bank transfer.',
      },
      {
        title: 'How quickly can I receive a quote?',
        description: 'Email info@kansogoods.com and we will reply with the catalog and price list within 24 hours.',
      },
    ]}
  />

  <!-- 底部 B2B 在线询盘表单区 -->
<section id="inquiry" class="py-16 md:py-24 bg-[#FAF6F0]">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <div class="bg-white rounded-3xl shadow-xl border border-amber-900/10 p-8 md:p-12">
      <div class="text-center max-w-2xl mx-auto mb-8">
        <p class="text-xs font-bold tracking-widest uppercase text-[#92400e]">Wholesale Price List &amp; Catalog</p>
        <h2 class="text-3xl md:text-4xl font-serif font-bold text-stone-900 mt-2">
          Ready to Stock Bestselling Wooden Kits?
        </h2>
        <p class="mt-3 text-base text-stone-600">
          Submit your inquiry below to receive our latest 100+ SKU digital catalog, carton specs, and wholesale price list within 12 hours.
        </p>
      </div>

      <form action="https://api.web3forms.com/submit" method="POST" class="space-y-5">
        <input type="hidden" name="access_key" value="8dfb5b66-c7b7-4c72-83db-b36d3817da76" />
        <input type="hidden" name="subject" value="New B2B Wholesale Inquiry - Kanso Goods" />
        <input type="hidden" name="from_name" value="Kanso Goods Website" />
        <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label class="block text-sm font-medium text-stone-700 mb-1.5">Your Name *</label>
            <input
              type="text"
              name="name"
              required
              placeholder="e.g. Sarah Jenkins"
              class="w-full rounded-xl border border-stone-300 px-4 py-3 text-stone-900 focus:border-[#92400e] focus:outline-none"
            />
          </div>
          <div>
            <label class="block text-sm font-medium text-stone-700 mb-1.5">Business Email *</label>
            <input
              type="email"
              name="email"
              required
              placeholder="sarah@yourstore.com"
              class="w-full rounded-xl border border-stone-300 px-4 py-3 text-stone-900 focus:border-[#92400e] focus:outline-none"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label class="block text-sm font-medium text-stone-700 mb-1.5">Company / Store Name *</label>
            <input
              type="text"
              name="company"
              required
              placeholder="e.g. Maple Leaf Bookstore"
              class="w-full rounded-xl border border-stone-300 px-4 py-3 text-stone-900 focus:border-[#92400e] focus:outline-none"
            />
          </div>
          <div>
            <label class="block text-sm font-medium text-stone-700 mb-1.5">Country / Destination Region *</label>
            <input
              type="text"
              name="country"
              required
              placeholder="e.g. USA / Japan / UK"
              class="w-full rounded-xl border border-stone-300 px-4 py-3 text-stone-900 focus:border-[#92400e] focus:outline-none"
            />
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-stone-700 mb-1.5">Interested Category &amp; Estimated Order</label>
          <textarea
            name="message"
            rows="3"
            placeholder="Tell us which series you are interested in (DIY Book Nooks, Miniature Dollhouses, 3D Wooden Puzzles) or if you'd like a 1-carton mixed trial quote..."
            class="w-full rounded-xl border border-stone-300 px-4 py-3 text-stone-900 focus:border-[#92400e] focus:outline-none"
          ></textarea>
        </div>

        <div class="pt-2 flex flex-col sm:flex-row items-center justify-between gap-4">
          <button
            type="submit"
            class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-[#8B4513] hover:bg-[#6F360E] text-white font-semibold shadow-md transition-colors cursor-pointer"
          >
            Request Digital Catalog &amp; Price List
          </button>
          <p class="text-sm text-stone-500">
            Prefer direct email? Write to <a href="mailto:info@kansogoods.com" class="font-medium text-[#8B4513] underline">info@kansogoods.com</a>
          </p>
        </div>
      </form>
    </div>
  </div>
</section>
</Layout>
