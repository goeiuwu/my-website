---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'About Us — Kanso Goods',
  description: 'Global B2B supplier specializing in wholesale wooden 3D puzzles, miniature dollhouses, and DIY book nooks.',
};
---

<Layout metadata={metadata}>
  <!-- 页面顶部简介 -->
  <HeroText
    tagline="About Kanso Goods"
    title="Dedicated B2B Supply Partner for Wooden 3D Puzzles & Book Nooks"
    subtitle="We connect overseas bookstores, gift shops, hobby retailers, and distributors directly with vetted manufacturing hubs in Dongguan & Shenzhen."
  />

  <!-- 3项核心服务定位（简洁明了，不暴露任何工厂品牌名） -->
  <Features2
    title="How We Support Your Business"
    columns={3}
    items={[
      {
        title: 'Curated Product Selection',
        description:
          'We focus exclusively on high-margin wooden 3D mechanical puzzles, miniature houses, and LED-lit DIY book nooks.',
        icon: 'tabler:puzzle',
      },
      {
        title: 'Strict Quality & Neutral Packaging',
        description:
          'Every shipment undergoes pre-dispatch inspection and uses clean neutral packaging without third-party factory branding.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Low-Risk Trial Orders',
        description:
          'Start with a 1-carton mixed trial order at competitive FOB Shenzhen pricing before scaling up to volume purchases.',
        icon: 'tabler:package',
      },
    ]}
  />

  <!-- 底部行动号召 -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Request Wholesale Price List',
        href: '/contact',
        icon: 'tabler:mail',
      },
    ]}
  >
    <Fragment slot="title">
      Let’s Build Your Wooden Puzzle Collection
    </Fragment>

    <Fragment slot="subtitle">
      Contact us at <span class="font-semibold">info@kansogoods.com</span> for our latest digital catalog and carton specifications.
    </Fragment>
  </CallToAction>
</Layout>
