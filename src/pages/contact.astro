---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Contact Us — Kanso Goods',
  description: 'Request our latest wooden 3D puzzle & DIY book nook catalog and FOB Shenzhen wholesale price list.',
};
---

<Layout metadata={metadata}>
  <!-- 页面顶部标题 -->
  <HeroText
    tagline="Wholesale Inquiry"
    title="Request Catalog & FOB Price List"
    subtitle="Tell us your target market and interested models. We reply to all wholesale inquiries within 24 hours."
  />

  <!-- 3个核心联系方式卡片（简洁直观，无长篇大论） -->
  <Features2
    title="Direct B2B Contact"
    columns={3}
    items={[
      {
        title: 'Sales & Quotation Email',
        description: 'info@kansogoods.com<br/>Send us your inquiry for full PDF catalogs and tiered USD pricing.',
        icon: 'tabler:mail',
      },
      {
        title: 'Trial Orders & MOQ',
        description: 'Starting from 1 carton (mixed models available for market testing).',
        icon: 'tabler:box',
      },
      {
        title: 'Trade Terms & Dispatch',
        description: 'FOB Shenzhen / EXW / DDP<br/>In-stock trial orders ship in 3–7 business days.',
        icon: 'tabler:ship',
      },
    ]}
  />

  <!-- 一键发邮件按钮 -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Email info@kansogoods.com',
        href: 'mailto:info@kansogoods.com?subject=Wholesale%20Inquiry%20-%20Wooden%203D%20Puzzles%20%26%20Book%20Nooks',
        icon: 'tabler:send',
      },
    ]}
  >
    <Fragment slot="title">
      Get Started With Your Trial Order
    </Fragment>

    <Fragment slot="subtitle">
      Click below to open your email client with a pre-filled subject, or write directly to <span class="font-semibold">info@kansogoods.com</span>.
    </Fragment>
  </CallToAction>
</Layout>
