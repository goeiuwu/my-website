---
import { Icon } from 'astro-icon/components';
import { getHomePermalink } from '~/utils/permalinks';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
  theme?: string;
}

const { socialLinks = [], secondaryLinks = [], links = [], footNote = '' } = Astro.props;
---

<footer class="bg-[#F4F1EA] text-stone-700 border-t border-stone-300/70">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 pt-14 pb-10">
    <!-- 四列均衡画廊网格：品牌主栏(4) + 2组导航(2+2) + B2B服务保障(4) -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-stone-300/70">
      <!-- 第1列：品牌识别与简介 -->
      <div class="md:col-span-4">
        <a class="inline-block font-serif font-bold text-2xl text-stone-900 tracking-tight" href={getHomePermalink()}>
          Kanso Goods
        </a>
        <p class="mt-3 text-sm text-stone-600 leading-relaxed max-w-xs">
          B2B wholesale supplier of wooden 3D puzzles, LED DIY book nooks, and miniature house kits for global retailers and distributors.
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
          <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium bg-white border border-stone-200 text-stone-700">
            1-Carton Trial MOQ
          </span>
          <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium bg-white border border-stone-200 text-stone-700">
            Neutral Packaging
          </span>
        </div>
      </div>

      <!-- 第2、3列：动态渲染 Products 与 Company 菜单 -->
      {
        links.map(({ title, links }) => (
          <div class="md:col-span-2">
            <div class="text-xs font-bold tracking-wider uppercase text-stone-900 mb-4">
              {title}
            </div>
            {links && Array.isArray(links) && links.length > 0 && (
              <ul class="space-y-2.5 text-sm">
                {links.map(({ text, href, ariaLabel }) => (
                  <li>
                    <a
                      class="text-stone-600 hover:text-[#8B4513] transition-colors duration-150"
                      href={href}
                      aria-label={ariaLabel}
                    >
                      <Fragment set:html={text} />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }

      <!-- 第4列：直接采购对接与质检标准 -->
      <div class="md:col-span-4 md:pl-6 md:border-l md:border-stone-300/60">
        <div class="text-xs font-bold tracking-wider uppercase text-stone-900 mb-4">
          Wholesale Desk
        </div>
        <ul class="space-y-2.5 text-sm text-stone-600">
          <li>
            <span class="text-stone-500">Email:</span>{' '}
            <a href="mailto:info@kansogoods.com" class="font-medium text-stone-900 hover:text-[#8B4513] underline decoration-stone-400">
              info@kansogoods.com
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- 底部极简版权与条款行 -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-stone-500">
      <div>
        <Fragment set:html={footNote} />
      </div>

      <div class="flex items-center gap-5">
        {
          secondaryLinks.map(({ text, href }) => (
            <a class="hover:text-stone-900 transition-colors" href={href} set:html={text} />
          ))
        }
        {
          socialLinks?.length ? (
            <ul class="flex items-center gap-3 pl-3 border-l border-stone-300">
              {socialLinks.map(({ ariaLabel, href, icon }) => (
                <li>
                  <a
                    class="text-stone-600 hover:text-stone-900 inline-flex items-center p-1 transition-colors"
                    aria-label={ariaLabel}
                    href={href}
                  >
                    {icon && <Icon name={icon} class="w-4 h-4" />}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            ''
          )
        }
      </div>
    </div>
  </div>
</footer>
